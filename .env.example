# Postgres (Railway)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DBNAME"

# Auth (roll-your-own — single user, password)
# AUTH_SECRET: 32+ chars. Generate with:  openssl rand -base64 32
# AUTH_USER_PASSWORD_HASH: bcrypt cost-12 hash. Generate with:
#   node -e "console.log(require('bcryptjs').hashSync('YOUR_PASSWORD', 12))"
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_USER_EMAIL="me@example.com"
AUTH_USER_PASSWORD_HASH="bcrypt-cost-12-hash"

# Google Cloud Storage
GCS_PROJECT_ID=""
GCS_BUCKET=""
GCS_KEY_FILE="./gcs-service-account.json"

# AI Gateway
AI_GATEWAY_API_KEY=""

# Brave Search (free tier — 2k queries/month is plenty for solo use).
# Used by the Company Research Assistant worker for recent-news lookup.
BRAVE_SEARCH_API_KEY=""

# Cron auth — Vercel Cron sends this as `Authorization: Bearer $CRON_SECRET`.
# Generate with: openssl rand -hex 32
CRON_SECRET=""
