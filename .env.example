# Postgres (Railway)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DBNAME"

# Auth (roll-your-own — single user, password)
# AUTH_SECRET: 32+ chars. Generate with:  openssl rand -base64 32
# AUTH_USER_PASSWORD_HASH: bcrypt cost-12 hash. Generate with:
#   node -e "console.log(require('bcryptjs').hashSync('YOUR_PASSWORD', 12))"
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_USER_EMAIL="me@example.com"
AUTH_USER_PASSWORD_HASH="bcrypt-cost-12-hash"

# Google Cloud Storage
GCS_PROJECT_ID=""
GCS_BUCKET=""
GCS_KEY_FILE="./gcs-service-account.json"

# AI Gateway
AI_GATEWAY_API_KEY=""

# Cron auth — Vercel Cron sends this as `Authorization: Bearer $CRON_SECRET`.
# Generate with: openssl rand -hex 32
CRON_SECRET=""

# Job Alert Aggregator — LinkedIn public-listings scrape uses an
# authenticated session cookie (the `li_at` value from your browser).
# Manually refreshed when it expires; missing value disables LinkedIn
# scraping but other adapters still run.
LINKEDIN_SESSION_COOKIE=""

# Weekly Digest email delivery (optional). When unset the digest is
# only surfaced on the Dashboard's Strategic Insights panel.
RESEND_API_KEY=""
RESEND_FROM_ADDRESS=""

# Brave Search (used by chunk-8 company-research worker; reserved here
# so .env.example tracks all worker-visible env in one place).
BRAVE_SEARCH_API_KEY=""
